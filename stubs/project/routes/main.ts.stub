import type { Router } from "{{bunaryHttp}}";

/**
 * Register base routes: / and /health
 */
export function registerMain(router: Router): void {
	router.get("/", () => ({
		message: "Welcome to Bunary!",
		docs: "https://github.com/bunary-dev",
	})).name("home");

	router.get("/health", () => ({
		status: "ok",
		timestamp: new Date().toISOString(),
	})).name("health");
}
