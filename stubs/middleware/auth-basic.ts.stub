import { type AuthConfig, createBasicGuard } from "@bunary/auth";
import { requireAuth } from "@bunary/auth/provider";
import type { Middleware } from "@bunary/http";

/**
 * Basic Auth: checks BASIC_AUTH_USER / BASIC_AUTH_PASSWORD from env (copy
 * .env.example to .env and fill them in; replace verify with a user lookup
 * for real users).
 *
 * - authConfig goes under the `auth` config key read by authProvider
 *   (src/index.ts: config: { ...config, auth: authConfig }, providers: [authProvider, ...]).
 * - {{functionName}} protects a group: router.group({ prefix: "/admin", middleware: [{{functionName}}] }, ...).
 *   Requests without valid credentials get a 401 problem response; handlers
 *   behind it read the user from ctx.locals.user.
 */
const envUser = process.env.BASIC_AUTH_USER;
const envPass = process.env.BASIC_AUTH_PASSWORD;
if (!envUser?.trim() || !envPass?.trim()) {
	throw new Error(
		"BASIC_AUTH_USER and BASIC_AUTH_PASSWORD are required. Copy .env.example to .env and fill them in (or set them in your environment).",
	);
}
// Keep only a hash; Bun.password.verify checks it in constant time.
const passwordHash = await Bun.password.hash(envPass);

export const authConfig: AuthConfig = {
	defaultGuard: "basic",
	guards: {
		basic: createBasicGuard({
			async verify(username, password) {
				if (username !== envUser) return null;
				if (!(await Bun.password.verify(password, passwordHash))) return null;
				return { id: username, username };
			},
		}),
	},
};

const required = requireAuth({ guard: "basic" });

/** requireAuth() plus the WWW-Authenticate challenge on its 401. */
export const {{functionName}}: Middleware = async (ctx, next) => {
	let authenticated = false;
	const result = await required(ctx, () => {
		authenticated = true;
		return next();
	});
	if (authenticated || !(result instanceof Response)) return result;
	const response = new Response(result.body, result);
	response.headers.set("WWW-Authenticate", 'Basic realm="app", charset="UTF-8"');
	return response;
};
