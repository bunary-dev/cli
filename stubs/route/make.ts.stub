import type { Router } from "@bunary/http";

/**
 * Register {{routeName}} routes.
 *
 * @example
 * ```ts
 * import { {{functionName}} } from "./{{routeName}}.js";
 * {{functionName}}(router);
 * ```
 */
export function {{functionName}}(router: Router): void {
	router.get("/{{routeName}}", () => ({
		data: [],
	})).name("{{routeName}}.index");

	router.get<{ id: string }>("/{{routeName}}/:id", (ctx) => ({
		id: ctx.params.id,
	})).name("{{routeName}}.show").whereNumber("id");

	// More routes — see https://github.com/bunary-dev/http#routing
	// router.post("/{{routeName}}", async (ctx) => {
	//   const body = await ctx.body.json<{ name: string }>();
	//   return ctx.json({ created: body.name }, { status: 201 });
	// }).name("{{routeName}}.create");
	//
	// router.delete<{ id: string }>("/{{routeName}}/:id", (ctx) => {
	//   return { deleted: ctx.params.id };
	// }).name("{{routeName}}.destroy").whereNumber("id");
}
