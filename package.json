{
	"name": "@bunary/cli",
	"version": "0.2.0",
	"description": "CLI scaffolding tool for Bunary - a Bun-first backend framework inspired by Laravel",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"bunary": "./dist/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "bun build ./src/index.ts --outdir ./dist --target bun && tsc -p tsconfig.build.json && mkdir -p dist/stubs && cp -r stubs/* dist/stubs/",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"lint": "biome check ./src ./tests",
		"format": "biome check --write ./src ./tests",
		"pack:check": "bun pm pack --dry-run"
	},
	"keywords": [
		"bunary",
		"bun",
		"cli",
		"scaffolding",
		"generator",
		"framework"
	],
	"author": "Paul Radford",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bunary-dev/cli.git"
	},
	"homepage": "https://github.com/bunary-dev/cli#readme",
	"bugs": {
		"url": "https://github.com/bunary-dev/cli/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"dependencies": {
		"@bunary/core": "^0.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
